# ============================================================================
# TEXMEX-MD — UNIVERSAL MULTI-DEVICE WHATSAPP BOT CONFIGURATION
# Copy to .env (or config.env on Pterodactyl/Katabump panels)
# ============================================================================

# --- Bot Identity ---
BOT_NAME=TEXMEX-MD
OWNER_NAME=TEXMEX-MD
OWNER_NUMBER=
SUDO_NUMBERS=

# --- Command Behaviour ---
PREFIX=.
MULTI_PREFIX=false
MODE=public

# --- Authentication & Session ---
# Paste your TEXMEX-MD~... string here for stateless clouds (Heroku, Render, Koyeb, Railway)
SESSION_ID=

# Optional: Set phone number (digits only, e.g. 254712345678) to auto-generate 8-digit pairing code in logs
PAIRING_NUMBER=
USE_CUSTOM_PAIRING_CODE=true
CUSTOM_PAIRING_CODE=TEXMEXMD
PRINT_QR=true
SEND_SESSION_ON_CONNECT=true

# --- Sticker Pack & Anime AI Bot DP Branding ---
STICKER_PACKNAME=TEXMEX-MD
STICKER_AUTHOR=TEXMEX-MD
AUTO_SET_BOT_DP=true
MENU_IMAGE=true
BOT_DP_URL=

# --- Automation & Protection Defaults ---
AUTO_READ=false
AUTO_STATUS_VIEW=true
AUTO_STATUS_REACT=false
STATUS_REACT_EMOJI=💚
AUTO_TYPING=false
AUTO_RECORDING=false
ANTI_DELETE=dm
ANTI_CALL=off

# --- Web Dashboard, Global Cloudflare Tunnel & Cloud Keep-Alive ---
# PORT is auto-detected on Heroku, Render, Koyeb, Railway, HuggingFace (7860), and Panels (SERVER_PORT)
PORT=3000
DASHBOARD_KEY=
KEEP_ALIVE_URL=
AUTO_SET_BIO=true
ENABLE_PUBLIC_TUNNEL=true
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional AI Provider Keys (.ai works without keys too!) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Timezone ---
TZ=Africa/Nairobi
